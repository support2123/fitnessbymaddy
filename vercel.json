{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/intake", "destination": "/public/intake.html" },
    { "source": "/checkin", "destination": "/public/checkin.html" },
    { "source": "/reschedule", "destination": "/public/reschedule.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-checkin",
      "schedule": "30 3 * * 0"
    },
    {
      "path": "/api/cron/nudge-dropped",
      "schedule": "0 6 * * *"
    }
  ]
}
