{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": { "runtime": "nodejs20.x", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/weekly-checkin", "schedule": "30 3 * * 0" },
    { "path": "/api/cron/nudge-dropped",  "schedule": "30 4 * * *" }
  ],
  "rewrites": [
    { "source": "/intake",      "destination": "/intake.html" },
    { "source": "/checkin",     "destination": "/checkin.html" },
    { "source": "/reschedule",  "destination": "/reschedule.html" },
    { "source": "/admin",       "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",       "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
