{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": null,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/intake", "dest": "/intake.html" },
    { "src": "/checkin", "dest": "/checkin.html" },
    { "src": "/reschedule", "dest": "/reschedule.html" },
    { "src": "/custom", "dest": "/custom.html" },
    { "src": "/shred", "dest": "/shred.html" },
    { "src": "/vip", "dest": "/vip.html" },
    { "src": "/admin/login", "dest": "/admin/login.html" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-checkin",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/nudge-dropped",
      "schedule": "0 6 * * *"
    }
  ],
  "env": {
    "SUPABASE_URL": "@supabase-url",
    "SUPABASE_SERVICE_KEY": "@supabase-service-key",
    "ANTHROPIC_API_KEY": "@anthropic-api-key",
    "AISENSY_API_KEY": "@aisensy-api-key",
    "RESEND_API_KEY": "@resend-api-key",
    "CRON_SECRET": "@cron-secret",
    "EXLY_WEBHOOK_SECRET": "@exly-webhook-secret"
  }
}
