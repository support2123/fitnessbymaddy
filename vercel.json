{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": { "memory": 1024, "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/weekly-checkin", "schedule": "30 3 * * 0" },
    { "path": "/api/cron/nudge-dropped", "schedule": "30 4 * * *" }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/intake", "destination": "/intake.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/reschedule", "destination": "/reschedule.html" }
  ]
}
