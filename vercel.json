{
  "framework": null,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-checkin",
      "schedule": "30 3 * * 0"
    },
    {
      "path": "/api/cron/nudge-dropped",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/checkin-submit.js": {
      "maxDuration": 30
    },
    "api/generate-program.js": {
      "maxDuration": 60
    }
  }
}
