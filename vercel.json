{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/generate-program.js": { "maxDuration": 60 },
    "api/cron/weekly-checkin.js": { "maxDuration": 60 },
    "api/cron/nudge-dropped.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/weekly-checkin", "schedule": "30 3 * * 0" },
    { "path": "/api/cron/nudge-dropped", "schedule": "30 4 * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
