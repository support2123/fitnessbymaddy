{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/intake.html", "dest": "/intake.html" },
    { "src": "/checkin.html", "dest": "/checkin.html" },
    { "src": "/reschedule.html", "dest": "/reschedule.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-checkin",
      "schedule": "30 3 * * 0"
    },
    {
      "path": "/api/cron/nudge-dropped",
      "schedule": "30 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ]
}
