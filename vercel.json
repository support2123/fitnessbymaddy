{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-checkin",
      "schedule": "30 3 * * 0"
    },
    {
      "path": "/api/cron/nudge-dropped",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/checkin-nudges",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/intake", "destination": "/intake.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/reschedule", "destination": "/reschedule.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
