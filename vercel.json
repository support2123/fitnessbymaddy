{
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/intake", "destination": "/intake.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/reschedule", "destination": "/reschedule.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://fitnessbymaddy.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/weekly-checkin", "schedule": "30 3 * * 0" },
    { "path": "/api/cron/nudge-dropped", "schedule": "0 4 * * *" }
  ]
}
