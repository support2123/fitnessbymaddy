{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/intake", "dest": "/intake.html" },
    { "src": "/checkin", "dest": "/checkin.html" },
    { "src": "/reschedule", "dest": "/reschedule.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-checkin",
      "schedule": "30 3 * * 0"
    },
    {
      "path": "/api/cron/nudge-dropped",
      "schedule": "0 6 * * *"
    }
  ],
  "env": {
    "AISENSY_API_KEY": "@aisensy_api_key",
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_SERVICE_KEY": "@supabase_service_key",
    "CLAUDE_API_KEY": "@claude_api_key",
    "RESEND_API_KEY": "@resend_api_key",
    "EXLY_WEBHOOK_SECRET": "@exly_webhook_secret",
    "CRON_SECRET": "@cron_secret"
  }
}
