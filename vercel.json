{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/intake", "dest": "/public/forms/intake.html" },
    { "src": "/checkin", "dest": "/public/forms/checkin.html" },
    { "src": "/reschedule", "dest": "/public/forms/reschedule.html" },
    { "src": "/admin", "dest": "/public/forms/admin.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ],
  "crons": [
    { "path": "/api/cron/weekly-checkin", "schedule": "30 3 * * 0" },
    { "path": "/api/cron/nudge-dropped", "schedule": "0 6 * * *" }
  ]
}
