# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# AiSensy WhatsApp
AISENSY_API_KEY=your-aisensy-api-key

# Claude API (for program generation)
CLAUDE_API_KEY=sk-ant-...your-claude-api-key

# Resend (email)
RESEND_API_KEY=re_...your-resend-key

# Exly webhook verification
EXLY_WEBHOOK_SECRET=your-exly-webhook-secret

# Internal API auth (generate a strong random string)
INTERNAL_API_KEY=generate-a-random-32-char-string

# Cron auth (Vercel cron secret)
CRON_SECRET=your-vercel-cron-secret

# Admin dashboard password
ADMIN_PASSWORD=set-a-strong-password

# Vercel deployment URL (auto-set by Vercel)
VERCEL_URL=fitnessbymaddy.vercel.app
