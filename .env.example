# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AiSensy / WhatsApp
AISENSY_API_KEY=your-aisensy-api-key

# Anthropic (Claude API for program generation)
CLAUDE_API_KEY=your-claude-api-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Exly webhook verification
EXLY_WEBHOOK_SECRET=your-exly-secret

# Maddy's WhatsApp for escalations
MADDY_PHONE=917082478374

# Cron secret (Vercel cron sends this header)
CRON_SECRET=your-cron-secret
