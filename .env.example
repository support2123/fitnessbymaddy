# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AiSensy WhatsApp API
AISENSY_API_KEY=your-aisensy-api-key

# Claude API (for program generation)
CLAUDE_API_KEY=your-claude-api-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Exly webhook verification
EXLY_WEBHOOK_SECRET=your-exly-webhook-secret

# Internal API key (for service-to-service calls)
INTERNAL_API_KEY=generate-a-random-uuid-here

# Vercel Cron Secret
CRON_SECRET=your-cron-secret
