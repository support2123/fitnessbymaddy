# FitnessByMaddy — copy to Vercel project env (never commit real values)

# Supabase (service role is server-only — NEVER expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# AiSensy (primary WA gateway)
AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com
AISENSY_CAMPAIGN_PREFIX=fbm_

# Meta Cloud API (fallback — activated when AISENSY_API_KEY absent)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERIFY_TOKEN=

# Maddy's personal WhatsApp (human-escalation target)
MADDY_WA_NUMBER=+917082478374

# Claude API (program architect)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-6

# Resend (support@fitnessbymaddy.com)
RESEND_API_KEY=

# Exly purchase webhook HMAC secret
EXLY_WEBHOOK_SECRET=

# Admin dashboard auth (Supabase user email allowlist, comma-separated)
ADMIN_EMAILS=support@fitnessbymaddy.com

# Cron shared secret (Vercel sends x-vercel-signature; we also gate on this)
CRON_SECRET=
