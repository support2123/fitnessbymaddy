# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AiSensy WhatsApp
AISENSY_API_KEY=your-aisensy-api-key

# Claude API (for program generation)
CLAUDE_API_KEY=your-anthropic-api-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Exly webhook verification
EXLY_WEBHOOK_SECRET=your-exly-webhook-secret

# Internal API auth
INTERNAL_API_KEY=generate-a-random-string-here

# Vercel (auto-set by Vercel)
VERCEL_URL=your-deployment.vercel.app
