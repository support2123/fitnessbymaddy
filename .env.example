# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AiSensy (WhatsApp)
AISENSY_API_KEY=your-aisensy-api-key

# Claude API (for program generation)
CLAUDE_API_KEY=your-claude-api-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Exly webhook verification
EXLY_WEBHOOK_SECRET=your-exly-secret

# Vercel Cron secret (auto-set by Vercel)
CRON_SECRET=your-cron-secret

# Admin dashboard password
ADMIN_PASSWORD=your-admin-password

# Maddy's phone for escalations
MADDY_PHONE=+917082478374

# Internal API key for send-whatsapp endpoint
INTERNAL_API_KEY=your-internal-key
