AISENSY_WEBHOOK_SECRET=                     # shared secret we verify on inbound

# ─── WhatsApp: Meta Cloud API (fallback) ─────────────────────
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# ─── Business ────────────────────────────────────────────────
