# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AiSensy (WhatsApp)
AISENSY_API_KEY=your-aisensy-api-key

# WhatsApp webhook verification
WA_VERIFY_TOKEN=your-custom-verify-token

# Anthropic (Claude API for program generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Exly webhook secret
EXLY_WEBHOOK_SECRET=your-exly-webhook-secret

# Internal API key (for send-whatsapp endpoint)
INTERNAL_API_KEY=your-internal-api-key
