# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# AiSensy (WhatsApp)
AISENSY_API_KEY=your-aisensy-api-key

# Claude API (for program generation)
CLAUDE_API_KEY=sk-ant-...

# Resend (email)
RESEND_API_KEY=re_...

# Exly webhook verification
EXLY_WEBHOOK_SECRET=your-exly-webhook-secret

# Internal API key (used for inter-service calls)
INTERNAL_API_KEY=generate-a-random-string-here

# Admin dashboard key
ADMIN_API_KEY=generate-another-random-string-here

# Vercel cron secret (auto-set by Vercel)
CRON_SECRET=auto-set-by-vercel
