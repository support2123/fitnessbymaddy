# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AiSensy (WhatsApp)
AISENSY_API_KEY=your-aisensy-api-key

# Anthropic (Claude API for program generation)
ANTHROPIC_API_KEY=your-claude-api-key

# Resend (Email)
RESEND_API_KEY=your-resend-api-key

# Exly Webhook Verification
EXLY_WEBHOOK_SECRET=your-exly-webhook-secret

# Vercel Cron Secret (set in Vercel dashboard)
CRON_SECRET=your-cron-secret

# Internal API key for send-whatsapp endpoint
INTERNAL_API_KEY=your-internal-api-key
